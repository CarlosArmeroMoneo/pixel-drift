<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text.PixelDrift.Support"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                style="@style/Text.PixelDrift.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_heading" />

            <TextView
                android:id="@+id/source_status"
                style="@style/Text.PixelDrift.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/source_status_empty" />

            <TextView
                style="@style/Text.PixelDrift.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/source_support" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/working"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/import_button"
                    style="@style/Widget.PixelDrift.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/import_artwork" />

                <Button
                    android:id="@+id/demo_button"
                    style="@style/Widget.PixelDrift.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/use_demo" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                style="@style/Text.PixelDrift.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/animation_heading" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.PixelDrift.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/columns_input"
                        android:text="@string/columns_label" />

                    <EditText
                        android:id="@+id/columns_input"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:maxLength="3"
                        android:selectAllOnFocus="true"
                        android:text="@string/columns_default"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.PixelDrift.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/rows_input"
                        android:text="@string/rows_label" />

                    <EditText
                        android:id="@+id/rows_input"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:maxLength="3"
                        android:selectAllOnFocus="true"
                        android:text="@string/rows_default"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.PixelDrift.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/frame_count_input"
                        android:text="@string/frame_count_label" />

                    <EditText
                        android:id="@+id/frame_count_input"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:maxLength="4"
                        android:selectAllOnFocus="true"
                        android:text="@string/frame_count_default"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.PixelDrift.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/grid_hint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                style="@style/Text.PixelDrift.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_heading" />

            <TextView
                style="@style/Text.PixelDrift.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/fps_spinner"
                android:text="@string/fps_label" />

            <Spinner
                android:id="@+id/fps_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/fps_labels"
                android:spinnerMode="dropdown" />

            <TextView
                style="@style/Text.PixelDrift.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/scale_spinner"
                android:text="@string/scale_label" />

            <Spinner
                android:id="@+id/scale_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/scale_labels"
                android:spinnerMode="dropdown" />

            <TextView
                style="@style/Text.PixelDrift.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/background_color_input"
                android:text="@string/background_color_label" />

            <EditText
                android:id="@+id/background_color_input"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/background_color_hint"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted" />

            <Switch
                android:id="@+id/battery_saver_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/freeze_battery_saver"
                android:textColor="@color/ink" />

            <TextView
                style="@style/Text.PixelDrift.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/freeze_battery_saver_summary" />

            <TextView
                style="@style/Text.PixelDrift.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/target_spinner"
                android:text="@string/target_label" />

            <Spinner
                android:id="@+id/target_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/target_labels"
                android:spinnerMode="dropdown" />

            <TextView
                style="@style/Text.PixelDrift.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_summary" />
        </LinearLayout>

        <TextView
            style="@style/Text.PixelDrift.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/draft_safety_summary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                style="@style/Widget.PixelDrift.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/save" />

            <Button
                android:id="@+id/preview_button"
                style="@style/Widget.PixelDrift.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1.35"
                android:text="@string/preview_set" />
        </LinearLayout>

        <TextView
            style="@style/Text.PixelDrift.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autoLink="web"
            android:linksClickable="true"
            android:text="@string/privacy_policy_link"
            android:textColorLink="@color/accent" />
    </LinearLayout>
</ScrollView>
